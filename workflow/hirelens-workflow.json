      "parameters": {
        "jsonSchemaExample": "{\n  \"id\": 1,\n  \"name\": \"Michael Anderson\",\n  \"email\": \"michael.anderson@example.com\",\n  \"phone\": \"+1 555 123 4567\",\n  \"job_id\": \"JOB-001\",\n  \"job_title\": \"Backend Developer\",\n  \"relevant_experience_years\": 4,\n  \"relevant_skills\": [\n    \"Python\",\n    \"Django\",\n    \"REST API\",\n    \"PostgreSQL\",\n    \"Git\"\n  ],\n  \"relevant_education\": {\n    \"degree\": \"Bachelor of Science\",\n    \"field\": \"Computer Science\",\n    \"institution\": \"University of Washington\"\n  },\n  \"score\": 89,\n  \"status\": \"interview\",\n  \"evaluation\": {\n    \"skills_score\": 45,\n    \"experience_score\": 27,\n    \"education_score\": 17,\n    \"matched_requirements\": [\n      \"Python\",\n      \"Django\",\n      \"REST API\",\n      \"PostgreSQL\",\n      \"Git\"\n    ],\n    \"missing_requirements\": [\n      \"Docker\"\n    ],\n    \"summary\": \"The candidate has strong technical skills, relevant professional experience, and an educational background closely aligned with the job requirements.\"\n  }\n}",
        "autoFix": true
      },
